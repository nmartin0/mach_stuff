OUTPUT_FORMAT("elf32-hppa")
OUTPUT_ARCH(hppa)
ENTRY("$START$")
SEARCH_DIR(/lib); SEARCH_DIR(/usr/lib); SEARCH_DIR(/usr/local/lib); SEARCH_DIR(/usr/hppa1.1-hp-linux/lib);
SECTIONS
{
  .text 0x1000 +0x1000:
  {
    __text_start = .;
    CREATE_OBJECT_SYMBOLS
    *(.PARISC.stubs)
    *(.text)
    etext = .;
    _etext = .;
  } =0
  . = .;
  .data    :
  {
     . = . + 0x1000 ;
    __data_start = .;
    *(.data)
    CONSTRUCTORS
    edata = .;
    _edata = .;
  }
  .bss    :
  {
   *(.bss)
   *(COMMON)
   end = . ;
   _end = . ;
  }
}
