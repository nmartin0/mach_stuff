+
+	kHWRateShift                    =       9,
+
+	kDMAOutEnable			=	0x00000100	/* Output DMA enabled */
+};
+
+/*--------------------- AWACs Clipping Count register ------------------------------------*/
+
+enum AWACsClippingCountRegisterConstants 
+{
