+#ifdef	CONFIG_OSFMACH3
+	if (!best) {
+		/* try to recover some unused but cached inodes */
+		inode = first_inode;
+		for (i = nr_inodes; i > 0; i--) {
+			if (inode->i_count == 1 &&
+			    inode->i_mem_object &&
+			    inode->i_mem_object->imo_cacheable) {
+				inode_pager_uncache_now(inode);
+				/* let the pager release the inode ... */
+				osfmach3_yield();
+				/* ... and try again */
+				goto repeat;
+			}
+			inode = inode->i_next;
+		}
+		/* no inode could be uncached, we're really out of inodes ... */
+	}
+#endif	/* CONFIG_OSFMACH3 */		
