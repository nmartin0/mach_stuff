--- DR2.1u5/DR2.1update5/mklinux/src/kernel/sched.c	Tue Jun  3 11:22:10 1997
+++ DR2.1u6/DR2.1update6/mklinux/src/kernel/sched.c	Thu Oct 30 11:04:13 1997
@@ -1188,7 +1188,7 @@
 	long psecs;
 
 #ifdef	CONFIG_OSFMACH3
-	osfmach3_update_task_info(p);
+	/* already updated by caller... */
 #else	/* CONFIG_OSFMACH3 */
 	p->utime += user;
 	p->stime += system;
@@ -1242,8 +1242,24 @@
 static void update_process_times(unsigned long ticks, unsigned long system)
 {
 #ifdef	CONFIG_OSFMACH3
-	if (current->pid)
-		update_one_process(current, ticks, 0, 0);
+	struct task_struct *p;
+	for_each_task(p) {
+		if (p->it_virt_value != 0 ||
+		    p->rlim[RLIMIT_CPU].rlim_cur != RLIM_INFINITY) {
+			long old_utime, old_stime;
+			unsigned long user;
+
+			old_utime = p->utime;
+			old_stime = p->stime;
+			osfmach3_update_thread_info(p);
+			if (p->utime != old_utime || p->stime != old_stime) {
+				system = p->stime - old_stime;
+				user = p->utime - old_utime;
+				update_one_process(p, user + system,
+						   user, system);
+			}
+		}
+	}
 #else	/* CONFIG_OSFMACH3 */
 #ifndef  __SMP__
 	struct task_struct * p = current;
