+	kHWRateMask	       		=	0x00000600,	/*All of the hardware sampling rate bits*/
+	kHWRate44100			=	0x00000400,	/*Hardware sampling bits for 44100 Hz*/
+	kHWRate29400			=	0x00000200,	/*Hardware sampling bits for 29400 Hz*/
