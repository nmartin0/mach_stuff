+
+	if (MACH_PORT_VALID(reply_to_name)) {
+		result = ipc_object_copyin(current_space(),
+					   reply_to_name,
+					   MACH_MSG_TYPE_MAKE_SEND,
+					   (ipc_object_t *) &reply_to);
+		if (result != KERN_SUCCESS) {
+			vm_object_deallocate(object);
+			return result;
