/*
 * MIG file for a UDP server
 */

subsystem udp 178000;

#include <mach/mach_types.defs>;
#include "udp_types.defs";

uimport "udp_defs.h";

/*
 * Use this routine to get a local udp endpoint.
 */
routine udp_getsport(
		proc_port	: mach_port_t;
	in	ipaddr		: unsigned;
	out	portnum		: short);

routine udp_sendto(
		proc_port	: mach_port_t;
	in	dst_ipaddr	: unsigned;
	in	dst_uport	: short;
	in	src_ipaddr	: unsigned;
	in	src_uport	: short;
	in	datagram	: datagram_t);

routine udp_sendto_n(
		proc_port	: mach_port_t;
	in	dst_ipaddr	: unsigned;
	in	dst_uport	: short;
	in	src_ipaddr	: unsigned;
	in	src_uport	: short;
	in	datagram	: datagram_t;
	in	n		: int);	/* number of packets to send */


routine udp_recvfrom(
		proc_port	: mach_port_t;
	in	dst_ipaddr	: unsigned;
	in	dst_uport	: short;
	out	src_ipaddr	: unsigned;
	out	src_uport	: short;
	out	datagram	: datagram_t);


