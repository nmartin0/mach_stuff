+ void
+ setstack_HiSax(struct PStack *st, struct IsdnCardState *sp)
+ {
+ 	st->l1.hardware = sp;
+ 	st->protocol = sp->protocol;
+ 
+ 	setstack_tei(st);
+ 
+ 	st->l1.stlistp = &(sp->stlist);
+ 	st->l1.act_state = 0;
+ 	st->l2.l2l1 = l2l1;
+ 	st->l2.l2l1discardq = HiSax_l2l1discardq;
+ 	st->ma.manl1 = HiSax_manl1;
+ 	st->l1.requestpull = 0;
+ }
