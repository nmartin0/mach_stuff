+ static inline __u32 b1prot(int l2, int l3)
+ {
+ 	switch (l2) {
+ 	case ISDN_PROTO_L2_X75I:
+ 	case ISDN_PROTO_L2_X75UI:
+ 	case ISDN_PROTO_L2_X75BUI:
