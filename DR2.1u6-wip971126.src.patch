+ MODULE_PARM(irq, "1-16i");
+ MODULE_PARM(mem, "1-16i");
+ MODULE_PARM(id, "s");
+ #ifdef CONFIG_HISAX_16_3	/* For Creatix/Teles PnP */
+ MODULE_PARM(io0, "1-16i");
+ MODULE_PARM(io1, "1-16i");
