+ 		struct ins_format2 format2;
+ 		struct ins_format3 format3;
+ 		u_int8_t	   bytes[4];
+ 	} format;
+ 	u_int	srcline;
+ 	struct symbol *patch_label;
+ 	struct {
+ 		struct instruction *stqe_next; /* next element */
+ 	} links;
+ };
