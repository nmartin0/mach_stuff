- {
-         int             foundcards = 0;
- 	int             i = 0;
- 
- 	while (i < nrcards) {
-                 if (!cards[i].protocol)
-                         break;
- 		switch (checkcard(i)) {
- 		  case (0):
- 			  initcard(i);
- 			  if (get_irq(i)) {
- 				  closecard(i);
-                                   teles_shiftcards(i);
-                           } else {
-                                   foundcards++;
-                                   i++;
-                           }
- 			  break;
- 		  case (-1):
