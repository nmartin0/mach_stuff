- static void
- l3_message(struct PStack *st, int mt)
- {
- 	struct BufHeader *dibh;
- 	byte           *p;
- 	int             size;
- 
- 	BufPoolGet(&dibh, st->l1.sbufpool, GFP_ATOMIC, (void *) st, 18);
- 	p = DATAPTR(dibh);
- 	p += st->l2.ihsize;
- 	size = st->l2.ihsize;
- 
- 	*p++ = 0x8;
- 	*p++ = 0x1;
- 	*p++ = st->l3.callref;
- 	*p++ = mt;
- 	size += 4;
- 
- 	dibh->datasize = size;
- 	i_down(st, dibh);
- }
- 
- static void
- l3s3(struct PStack *st, byte pr, void *arg)
- {
- 	l3_message(st, MT_RELEASE);
- 	newl3state(st, 19);
- }
