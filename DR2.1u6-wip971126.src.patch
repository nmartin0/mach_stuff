- static void
- check_ph_act(struct IsdnCardState *sp)
- {
- 	struct PStack  *st = sp->stlist;
- 
- 	while (st) {
- 		if (st->l1.act_state)
- 			return;
- 		st = st->next;
- 	}
- 	sp->ph_active = 0;
- }
