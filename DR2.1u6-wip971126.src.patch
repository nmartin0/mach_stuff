+ #define byteTLcpy(x,y)        *(__u8 *)(x)=*(__u8 *)(y);
+ #define wordTLcpy(x,y)        *(__u16 *)(x)=*(__u16 *)(y);
+ #define dwordTLcpy(x,y)       memcpy(x,y,4);
+ #define structTLcpy(x,y,l)    memcpy (x,y,l)
+ #define structTLcpyovl(x,y,l) memmove (x,y,l)
