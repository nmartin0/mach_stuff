+ static void
+ srom_exec(struct device *dev, u_char *p)
+ {
+     struct de4x5_private *lp = (struct de4x5_private *)dev->priv;
+     u_long iobase = dev->base_addr;
+     u_char count = (p ? *p++ : 0);
