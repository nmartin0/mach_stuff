+ int read_cross_byte (struct specialix_board *bp, int reg, int bit)
+ {
+ 	int i;
+ 	int t;
+ 
+ 	for (i=0, t=0;i<8;i++) {
+ 		sx_out_off (bp, CD186x_CAR, i);
+ 		if (sx_in_off (bp, reg) & bit) 
+ 			t |= 1 << i;
+ 	}
+ 	return t;
+ }
