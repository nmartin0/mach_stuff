- static int
- my_atoi(char *s)
- {
-         int             i, n;
- 
-         n = 0;
-         if (!s)
-                 return -1;
-         for (i = 0; *s >= '0' && *s <= '9'; i++, s++)
-                 n = 10 * n + (*s - '0');
-         return n;
- }
