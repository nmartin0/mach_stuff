- static void
- teles_l2l1(struct PStack *st, int pr,
- 	   struct BufHeader *ibh)
- {
- 	struct IsdnCardState *sp = (struct IsdnCardState *)
- 	st->l1.hardware;
- 
- 
- 	switch (pr) {
- 	  case (PH_DATA):
- 		  if (sp->xmtibh)
- 			  BufQueueLink(&sp->sq, ibh);
- 		  else {
- 			  sp->xmtibh = ibh;
- 			  sp->sendptr = 0;
- 			  sp->releasebuf = !0;
- 			  fill_fifo(sp);
- 		  }
- 		  break;
- 	  case (PH_DATA_PULLED):
- 		  if (sp->xmtibh) {
- 			  printk(KERN_DEBUG "teles_l2l1: this shouldn't happen\n");
- 			  break;
- 		  }
- 		  sp->xmtibh = ibh;
- 		  sp->sendptr = 0;
- 		  sp->releasebuf = 0;
- 		  fill_fifo(sp);
- 		  break;
- 	  case (PH_REQUEST_PULL):
- 		  if (!sp->xmtibh) {
- 			  st->l1.requestpull = 0;
- 			  st->l1.l1l2(st, PH_PULL_ACK, NULL);
- 		  } else
- 			  st->l1.requestpull = !0;
- 		  break;
- 	}
- }
