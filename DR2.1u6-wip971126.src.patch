- static int
- act_wanted(struct IsdnCardState *sp)
- {
- 	struct PStack  *st;
- 
- 	st = sp->stlist;
- 	while (st)
- 		if (st->l1.act_state)
- 			return (!0);
- 		else
- 			st = st->next;
