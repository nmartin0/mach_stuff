+ static inline int new_bchan(capidrv_contr * card)
+ {
+ 	int i;
+ 	for (i = 0; i < card->nbchan; i++) {
+ 		if (card->bchans[i].plcip == 0) {
+ 			card->bchans[i].disconnecting = 0;
