+ static void
+ l2m_debug(struct FsmInst *fi, char *s)
+ {
+ 	struct PStack *st = fi->userdata;
+ 	char tm[32], str[256];
+ 
+ 	jiftime(tm, jiffies);
+ 	sprintf(str, "%s %s %s\n", tm, st->l2.debug_id, s);
+ 	HiSax_putstatus(st->l1.hardware, str);
+ }
