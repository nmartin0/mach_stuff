+ int gdth_release(struct Scsi_Host *shp)
+ {
+     unsigned long flags;
+ 
+     TRACE2(("gdth_release()\n"));
+ 
+     save_flags(flags);
+     cli();
+     if (NUMDATA(shp)->busnum == 0) {
+         if (shp->irq) {
+ #if LINUX_VERSION_CODE >= 0x010346
+             free_irq(shp->irq,NULL);
+ #else
+             free_irq(shp->irq);
+ #endif
+         }
+         if (shp->dma_channel != 0xff) {
+             free_dma(shp->dma_channel);
+         }
+     }
+ 
+     restore_flags(flags);
+     scsi_unregister(shp);
+     return 0;
+ }
