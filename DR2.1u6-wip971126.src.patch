- void
- teles_rmlist(struct IsdnCardState *sp,
- 	     struct PStack *st)
- {
- 	struct PStack  *p;
- 
- 	if (sp->stlist == st)
- 		sp->stlist = st->next;
- 	else {
- 		p = sp->stlist;
- 		while (p)
- 			if (p->next == st) {
- 				p->next = st->next;
