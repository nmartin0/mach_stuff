- 	p = DATAPTR(ibh);
- 	if (st->protocol == ISDN_PTYPE_1TR6) {
- 		if ((p = findie(p + st->l2.uihsize, ibh->datasize - st->l2.uihsize, 0x01, 6))) {
- 			st->pa->info = p[2];
- 			st->pa->info2 = p[3];
- 		} else
