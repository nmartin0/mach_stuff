- static void
- teles_manl1(struct PStack *st, int pr,
- 	    void *arg)
- {
- 	struct IsdnCardState *sp = (struct IsdnCardState *)
- 	st->l1.hardware;
- 	long            flags;
- 
- 	switch (pr) {
- 	  case (PH_ACTIVATE):
- 		  save_flags(flags);
- 		  cli();
- 		  if (sp->ph_active == 5) {
- 			  st->l1.act_state = 2;
- 			  restore_flags(flags);
- 			  st->l1.l1man(st, PH_ACTIVATE, NULL);
- 		  } else {
- 			  st->l1.act_state = 1;
- 			  if (sp->ph_active == 0)
- 				  restart_ph(sp);
- 			  restore_flags(flags);
- 		  }
- 		  break;
- 	  case (PH_DEACTIVATE):
- 		  st->l1.act_state = 0;
- 		  check_ph_act(sp);
- 		  break;
- 	}
