+ static void
+ l2tei_dummy(struct PStack *st, int pr, void *arg)
+ {
+ 	struct Channel *chanp = (struct Channel *) st->l4.userdata;
+ 	char tmp[64], tm[32];
+ 
+ 	jiftime(tm, jiffies);
+ 	sprintf(tmp, "%s Channel %d Warning! Dummy l2tei called pr=%d\n", tm, chanp->chan, pr);
+ 	HiSax_putstatus(chanp->sp, tmp);
+ }
