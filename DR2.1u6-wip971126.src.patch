- setstack_isdnl2(struct PStack *st, char *debug_id)
- {
- 	st->l1.l1l2 = isdnl2_l1l2;
- 	st->l3.l3l2 = isdnl2_l3l2;
- 	st->ma.manl2 = isdnl2_manl2;
- 	st->ma.teil2 = isdnl2_teil2;
