- 	mov	HADDR0,DFDAT
- 	mov	HADDR1,DFDAT
- 	mov	HADDR2,DFDAT
- 	mov	HADDR3,DFDAT
- 	mov	HCNT0,DFDAT
- 	mov	HCNT1,DFDAT
- 	mov	HCNT2,DFDAT
