+ const char *gdth_info(struct Scsi_Host *shp)
+ {
+     int hanum;
+     
+     TRACE2(("gdth_info()\n"));
+     hanum = NUMDATA(shp)->hanum;
+ 
+     return (gdth_ctr_name(hanum));
+ }
