-  * Copy data from FIFO into SCB data pointer and data count.  In
-  * both FreeBSD and Linux, the scatter list entry is 8 bytes.
-  * 
-  * struct ahc_dma_seg {
-  *       physaddr addr;                  four bytes, little-endian order
-  *       long    len;                    four bytes, little endian order
-  * };
