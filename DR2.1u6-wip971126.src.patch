- 	mov	HADDR0, SCB_CMDPTR0
- 	mov	HADDR1, SCB_CMDPTR1
- 	mov	HADDR2, SCB_CMDPTR2
- 	mov	HADDR3, SCB_CMDPTR3
- 	mov	HCNT0, SCB_CMDLEN
- 	clr	HCNT1
- 	clr	HCNT2
- 
- 	mov	STCNT0, HCNT0
- 	mov	STCNT1, HCNT1
- 	mov	STCNT2, HCNT2
