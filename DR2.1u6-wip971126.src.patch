+ 
+ 	p++;
+ 	l = *p++ - 1;
+ 	dp += sprintf(dp, "    GEA ");
+ 	dp += prbits(dp, *p++, 8, 8);
+ 	dp += sprintf(dp, "  Anzahl: ");
+ 	/* Iterate over all octets in the * information element */
+ 	while (l--)
+ 		*dp++ = *p++;
+ 	*dp++ = '\n';
+ 	return (dp - dest);
+ }
