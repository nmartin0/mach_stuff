+ #define MDIO_SHIFT_CLK	0x01
+ #define MDIO_DIR_WRITE	0x04
+ #define MDIO_DATA_WRITE0 (0x00 | MDIO_DIR_WRITE)
+ #define MDIO_DATA_WRITE1 (0x02 | MDIO_DIR_WRITE)
+ #define MDIO_DATA_READ	0x02
+ #define MDIO_ENB_IN		0x00
