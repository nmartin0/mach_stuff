- 
- 	st->l2.l2m.fsm = &l2fsm;
- 	st->l2.l2m.state = ST_L2_1;
- 	st->l2.l2m.debug = 0;
- 	st->l2.l2m.userdata = st;
- 	st->l2.l2m.printdebug = l2m_debug;
- 	strcpy(st->l2.debug_id, debug_id);
- 
- 	FsmInitTimer(&st->l2.l2m, &st->l2.t200_timer);
- 	FsmInitTimer(&st->l2.l2m, &st->l2.t203_timer);
