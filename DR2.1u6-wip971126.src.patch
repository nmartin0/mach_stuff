- 	BufPoolGet(&dibh, st->l1.sbufpool, GFP_ATOMIC, (void *) st, 20);
- 	p = DATAPTR(dibh);
- 	p += st->l2.ihsize;
- 	size = st->l2.ihsize;
- 
- 	*p++ = 0x8;
- 	*p++ = 0x1;
- 	*p++ = st->l3.callref;
- 	*p++ = MT_STATUS;
- 	size += 4;
- 
- 	*p++ = IE_CAUSE;
- 	*p++ = 0x2;
- 	*p++ = 0x80;
- 	*p++ = 0x9E; /* answer status enquire */
- 	size += 4;
- 
- 	*p++ = 0x14; /* CallState */
- 	*p++ = 0x1;
- 	*p++ = st->l3.state & 0x3f; /* ISO L3 CallState */
- 	size += 3;
- 
- 	dibh->datasize = size;
- 	i_down(st, dibh);
