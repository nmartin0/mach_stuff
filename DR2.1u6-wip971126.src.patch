+ 		ic.command = ISDN_STAT_DHUP;
+ 		ic.arg = chanp->chan;
+ 		chanp->sp->iif.statcallb(&ic);
+ 	}
+ 	SETBIT(chanp->Flags, FLG_DISC_SEND);	/* DISCONN was sent from L3 */
+ }
