- 		for (p = strtok(p, ", \t\n"); p; p = strtok(NULL, ", \t\n"))
- 			if (i < MAXTOKEN-1)
- 				a[i++] = p;
- 			else
- 				error("too many tokens");
- 		if (quote) {
