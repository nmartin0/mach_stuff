- 			p = strchr(quote, '\"');
- 			if (!p)
- 				error("unterminated string constant");
- 			else if (i < MAXTOKEN-1) {
- 				a[i++] = quote;
- 				*p = '\0';
- 				p++;
- 			}
- 			else
