+ 	else if (gcw.device_type != 0)
+ 		printk (KERN_ERR "ide-floppy: Device type is not set to floppy\n");
+ 	else if (!gcw.removable)
+ 		printk (KERN_ERR "ide-floppy: The removable flag is not set\n");
+ 	else if (gcw.drq_type == 3)
