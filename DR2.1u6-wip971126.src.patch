+ 		printk("--> Entering function %s\n", dbg_funcname);
+ }
+ 
+ inline char *strcpy(char *dest, const char *src)
+ {
+ 	char *i = dest;
+ 	char *j = (char *) src;
+ 
+ 	while(*j) {
+ 		*i = *j;
+ 		i++; j++;
+ 	}
+ 	*(++i) = NULL;
+ 	return dest;
+ }
