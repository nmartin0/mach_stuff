+ static int
+ prcalled(char *dest, u_char * p)
+ {
+ 	int l;
+ 	char *dp = dest;
+ 
+ 	p++;
+ 	l = *p++ - 1;
+ 	dp += sprintf(dp, "    octet 3 ");
+ 	dp += prbits(dp, *p++, 8, 8);
+ 	*dp++ = '\n';
+ 	dp += sprintf(dp, "    number digits ");
+ 	while (l--)
+ 		*dp++ = *p++;
+ 	*dp++ = '\n';
+ 	return (dp - dest);
+ }
+ static int
+ prcalling(char *dest, u_char * p)
+ {
+ 	int l;
+ 	char *dp = dest;
+ 
+ 	p++;
+ 	l = *p++ - 1;
+ 	dp += sprintf(dp, "    octet 3 ");
+ 	dp += prbits(dp, *p, 8, 8);
+ 	*dp++ = '\n';
+ 	if (!(*p & 0x80)) {
+ 		dp += sprintf(dp, "    octet 3a ");
+ 		dp += prbits(dp, *++p, 8, 8);
+ 		*dp++ = '\n';
+ 		l--;
+ 	};
+ 	p++;
+ 
+ 	dp += sprintf(dp, "    number digits ");
+ 	while (l--)
+ 		*dp++ = *p++;
+ 	*dp++ = '\n';
+ 	return (dp - dest);
+ }
