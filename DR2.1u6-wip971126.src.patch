+ static int
+ general(char *dest, u_char * p)
+ {
+ 	char *dp = dest;
+ 	char ch = ' ';
+ 	int l, octet = 3;
+ 
+ 	p++;
+ 	l = *p++;
+ 	/* Iterate over all octets in the information element */
+ 	while (l--) {
+ 		dp += sprintf(dp, "    octet %d%c ", octet, ch);
+ 		dp += prbits(dp, *p++, 8, 8);
+ 		*dp++ = '\n';
+ 
+ 		/* last octet in group? */
+ 		if (*p & 0x80) {
+ 			octet++;
+ 			ch = ' ';
+ 		} else if (ch == ' ')
+ 			ch = 'a';
+ 		else
+ 			ch++;
+ 	}
+ 	return (dp - dest);
+ }
+ 
