+ /* How to wait for the command unit to accept a command.
+    Typically this takes 0 ticks. */
+ static inline void wait_for_cmd_done(int cmd_ioaddr)
+ {
+   short wait = 100;
+   do   ;
+   while(inb(cmd_ioaddr) && --wait >= 0);
+ }
