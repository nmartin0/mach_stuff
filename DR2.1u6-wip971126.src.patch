+ static void jumpcstruct(_cmsg * cmsg)
+ {
+ 	unsigned layer;
+ 	for (cmsg->p++, layer = 1; layer;) {
+ 		/* $$$$$ assert (cmsg->p); */
+ 		cmsg->p++;
+ 		switch (TYP) {
+ 		case _CMSTRUCT:
+ 			layer++;
+ 			break;
+ 		case _CEND:
+ 			layer--;
+ 			break;
+ 		}
+ 	}
+ }
