+ 	unsigned char seq_no;		/* Next send seq. number */
+ 	struct timer_list reset_timer;	/* Check reset timer */
+ 	struct timer_list stat_timer;	/* Check startproc timer */
+ 	unsigned char nphystat;		/* Latest PhyStat info */
