+ static const char *gdth_ctr_name(int hanum)
+ {
+     gdth_ha_str *ha;
+ 
+     TRACE2(("gdth_ctr_name()\n"));
+ 
+     ha    = HADATA(gdth_ctr_tab[hanum]);
+ 
+     if (ha->type == GDT_EISA) {
+         switch (ha->stype) {
+           case GDT3_ID:
+             return("GDT3000/3020 (EISA)");
