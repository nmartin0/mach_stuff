+ static void send_sigio(int sig, int pid, uid_t uid, uid_t euid)
+ {
+ 	struct task_struct * p;
+ 
+ 	for_each_task(p) {
+ 		int match = p->pid;
+ 		if (pid < 0)
+ 			match = -p->pgrp;
+ 		if (pid != match)
+ 			continue;
+ 		if (!euid &&
+ 		    (euid ^ p->suid) && (euid ^ p->uid) &&
+ 		    (uid ^ p->suid) && (uid ^ p->uid))
