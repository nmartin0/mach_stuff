- static int 
- prbits(char *dest, byte b, int start, int len)
- {
- 	char           *dp = dest;
- 
- 	b = b << (8 - start);
- 	while (len--) {
- 		if (b & 0x80)
- 			*dp++ = '1';
- 		else
- 			*dp++ = '0';
- 		b = b << 1;
- 	}
- 	return (dp - dest);
- }
