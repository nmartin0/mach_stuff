+ static int
+ display(char *dest, u_char * p)
+ {
+ 	char *dp = dest;
+ 	char ch = ' ';
+ 	int l, octet = 3;
+ 
+ 	p++;
+ 	l = *p++;
+ 	/* Iterate over all octets in the * display-information element */
+ 	dp += sprintf(dp, "   \"");
+ 	while (l--) {
+ 		dp += sprintf(dp, "%c", *p++);
+ 
+ 		/* last octet in group? */
+ 		if (*p & 0x80) {
+ 			octet++;
+ 			ch = ' ';
+ 		} else if (ch == ' ')
+ 			ch = 'a';
+ 
+ 		else
+ 			ch++;
+ 	}
+ 	*dp++ = '\"';
+ 	*dp++ = '\n';
+ 	return (dp - dest);
+ }
