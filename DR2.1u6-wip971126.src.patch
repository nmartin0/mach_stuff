- static void
- l3_1tr6_conn(struct PStack *st, byte pr,
- 	     void *arg)
- {
- 	struct BufHeader *dibh;
- 	byte *p;
- 
- 	st->l3.callref = 0x80 + st->pa->callref;
- 
- 	BufPoolGet(&dibh, st->l1.sbufpool, GFP_ATOMIC, (void *) st, 20);
- 	p = DATAPTR(dibh);
- 	p += st->l2.ihsize;
- 
- 	*p++ = PROTO_DIS_N1;
- 	*p++ = 0x1;
- 	*p++ = st->l3.callref;
- 	*p++ = MT_N1_CONN;
- 
- 	if (st->pa->spv) {	/* SPV ??? */
- 		/* NSF SPV */
- 		*p++ = WE0_netSpecFac;
- 		*p++ = 4;	/* Laenge */
- 		*p++ = 0;
- 		*p++ = FAC_SPV;	/* SPV */
- 		*p++ = st->pa->info;
- 		*p++ = st->pa->info2;
- 		*p++ = WE0_netSpecFac;
- 		*p++ = 4;	/* Laenge */
- 		*p++ = 0;
- 		*p++ = FAC_Activate;	/* aktiviere SPV */
- 		*p++ = st->pa->info;
- 		*p++ = st->pa->info2;
- 	}
- 	dibh->datasize = p - DATAPTR(dibh);
- 
- 	i_down(st, dibh);
- 
- 	newl3state(st, 8);
- }
- 
- static void
- l3_1tr6_reset(struct PStack *st, byte pr, void *arg)
- {
