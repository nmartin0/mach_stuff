+ void
+ isac_sched_event(struct IsdnCardState *sp, int event)
+ {
+ 	sp->event |= 1 << event;
+ 	queue_task(&sp->tqueue, &tq_immediate);
+ 	mark_bh(IMMEDIATE_BH);
