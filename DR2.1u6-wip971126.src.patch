+ 	_cstruct BChannelinformation;
+ 	_cmstruct BProtocol;
+ 	_cstruct CalledPartyNumber;
+ 	_cstruct CalledPartySubaddress;
+ 	_cstruct CallingPartyNumber;
+ 	_cstruct CallingPartySubaddress;
+ 	__u32 CIPmask;
+ 	__u32 CIPmask2;
+ 	__u16 CIPValue;
+ 	__u32 Class;
