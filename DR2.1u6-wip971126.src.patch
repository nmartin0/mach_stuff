- static void
- act_ivated(struct IsdnCardState *sp)
- {
- 	struct PStack  *st;
- 
- 	st = sp->stlist;
- 	while (st) {
- 		if (st->l1.act_state == 1) {
- 			st->l1.act_state = 2;
- 			st->l1.l1man(st, PH_ACTIVATE, NULL);
- 		}
- 		st = st->next;
- 	}
- }
