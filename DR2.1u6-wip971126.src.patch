- /* Load STCNT as well.  It is a mirror of HCNT */
- 	mov	STCNT0,HCNT0
- 	mov	STCNT1,HCNT1
- 	mov	STCNT2,HCNT2
-         test    SSTAT1,PHASEMIS  jz data_phase_loop
- 
- data_phase_finish:
