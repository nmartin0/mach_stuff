  # int processes an integer argument
  #
  #	int question define default
! #
  function int () {
  	old=$(eval echo "\${$2}")
  	def=${old:-$3}
  	while :; do
  	  readln "$1 ($2) [$def] " "$def" "$old"
! 	  if expr "$ans" : '0$\|\(-[1-9]\|[1-9]\)[0-9]*$' > /dev/null; then
  	    define_int "$2" "$ans"
  	    break
  	  else
