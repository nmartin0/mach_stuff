- static void
- l3_1TR6_message(struct PStack *st, int mt, int pd)
- {
- 	struct BufHeader *dibh;
- 	byte           *p;
- 
- 	BufPoolGet(&dibh, st->l1.sbufpool, GFP_ATOMIC, (void *) st, 18);
- 	p = DATAPTR(dibh);
- 	p += st->l2.ihsize;
- 
- 	*p++ = pd;
- 	*p++ = 0x1;
- 	*p++ = st->l3.callref;
- 	*p++ = mt;
- 
- 	dibh->datasize = p - DATAPTR(dibh);
- 	i_down(st, dibh);
