+ int
+ prfacility(char *dest, u_char * p)
+ {
+ 	char *dp = dest;
+ 	int l, l2;
+ 
+ 	p++;
+ 	l = *p++;
+ 	dp += sprintf(dp, "    octet 3 ");
+ 	dp += prbits(dp, *p++, 8, 8);
+ 	dp += sprintf(dp, "\n");
+ 	l -= 1;
+ 
+ 	while (l > 0) {
+ 		dp += sprintf(dp, "   octet 4 ");
+ 		dp += prbits(dp, *p++, 8, 8);
+ 		dp += sprintf(dp, "\n");
+ 		dp += sprintf(dp, "   octet 5 %d\n", l2 = *p++ & 0x7f);
+ 		l -= 2;
+ 		dp += sprintf(dp, "   contents ");
+ 		while (l2--) {
+ 			dp += sprintf(dp, "%2x ", *p++);
+ 			l--;
+ 		}
+ 		dp += sprintf(dp, "\n");
+ 	}
+ 
+ 	return (dp - dest);
+ }
