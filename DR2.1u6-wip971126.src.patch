  # int processes an integer argument
  #
  #	int question define default
! # GNU expr changed handling of ?.  In older versions you need ?,
! # in newer you need \?
! OLD_EXPR=`expr "0" : '0\?'`
! if [ $OLD_EXPR -eq 1 ]; then
!     INT_EXPR='0$\|-\?[1-9][0-9]*$'
! else
!     INT_EXPR='0$\|-?[1-9][0-9]*$'
! fi
  function int () {
  	old=$(eval echo "\${$2}")
  	def=${old:-$3}
  	while :; do
  	  readln "$1 ($2) [$def] " "$def" "$old"
! 	  if expr "$ans" : $INT_EXPR > /dev/null; then
  	    define_int "$2" "$ans"
  	    break
  	  else
