/************************************************************************
 *
 *  Function:		Pause
 *
 *  Purpose:		let the user digest what they've seen
 *
 *  Returns:		nothing
 *
 *  Side Effects:	may exit program suddenly
 *
 *  Description:	Ask the user to go on or quit.  If quit, ExitToShell()
 *
 ************************************************************************/
void
Pause()
{
	char	answer;
	
	answer = 'z';
	printf("Type q to quit, or any other key to continue:");
	answer = getchar();
	if (answer == 'q' || answer == 'Q')
		ExitToShell();
	else
		printf("\n\n");	
}



/************************************************************************
 *
 *  Function:		YesOrNo
 *
 *  Purpose:		ask a yes or no question and return an answer
 *
 *  Returns:		Boolean
 *						true	user answered 'y' or 'Y'
 *						false	user answered 'n' or 'N'
 *
 *  Side Effects:	none
 *
 *  Description:	ask the question passed in.  Get the answer until
 *					it's either 'n' or 'y' (case insensitive.) Return
 *					true if 'y', false if 'n'.
 *
 ************************************************************************/
Boolean
YesOrNo(prompt)
char *prompt;
{
	short	answer;
	
	answer = 'z';
	while (answer != 'y' && answer != 'Y' && answer != 'n' && answer != 'N')
	{
		printf(prompt);
		answer = getchar();
	}
	printf("\n");
	if (answer == 'n' || answer == 'N')
		return false;
	else
		return true;
}


/************************************************************************
 *
 *  Function:		Open
 *
 *  Purpose:		Open the driver for i/o
 *
 *  Returns:		OSErr
 *
 *  Side Effects:	fills *RefNum with valid reference number for driver.
 *
 *  Description:	Issue Mac OS PBOpen call to open the driver.  We
 *					can use the returned reference number to access the
 *					driver for raw i/o.
 *
 ************************************************************************/
OSErr
Open(fn, RefNum)
StringPtr	fn;
short		*RefNum;
{
	OSErr			result;
	ParamBlockRec	pb;
	
	pb.ioParam.ioNamePtr = fn;
	pb.ioParam.ioCompletion = 0;
	pb.ioParam.ioPermssn = fsRdPerm;
	result = PBOpen(&pb, false);
	*RefNum = pb.ioParam.ioRefNum;
	
	return result;
}


/************************************************************************
 *
 *  Function:	Read
 *
 *  Purpose:	read from the driver
 *
 *  Returns:	OSErr
 *
 *  Side Effects:	fills dest with contents for 'count' bytes.
 *
 *  Description:	do a call to the Mac CD driver to read a specified
 *					number of bytes starting at 'offset'.  If you are
 *					trying to port this to another machine, this is
 *					the important routine.  Given an absolute offset
 *					from the beginning of the disc, read "count"
 *					bytes into "dest".
 *
 ************************************************************************/
OSErr
Read(refNum, dest, count, offset)
short	refNum;
Ptr		dest;
long	count;
long	offset;
{
	OSErr result;
	ParamBlockRec	io;
	
	io.ioParam.ioCompletion = NULL;
	io.ioParam.ioVRefNum = 1;
	io.ioParam.ioRefNum = refNum;
	io.ioParam.ioBuffer = dest;
	io.ioParam.ioReqCount = count;
	io.ioParam.ioPosMode = fsFromStart;
	io.ioParam.ioPosOffset = offset;
	result = PBRead(&io, false);
	
	if (result != noErr)
		printf("PBRead failed. ioActCount = %d\n", io.ioParam.ioActCount);
	
	return result;
}



/************************************************************************
 *
 *  Function:	NormalizeLong
 *
 *  Purpose:	normalize a long number that's in most significant byte format
 *
 *  Returns:	long
 *
 *  Side Effects:	none
 *
 *  Description:
 *				takes a long in msb format order and converts it
 *				to lsb format order.  For example, the long value
 *				0x12345678 becomes 0x78563412
 *				0x78563412 becomes 0x12345678
 *
 ************************************************************************/
long
NormalizeLong(incoming)
long	incoming;
{
	unsigned char	*byteArray;
	long	result;
	
	byteArray = (unsigned char *) &incoming;
	result = (long) byteArray[0] | 
			 (long) byteArray[1] << 8 | 
			 (long) byteArray[2] << 16 |
			 (long) byteArray[3] << 24;
	
	return result;
}

/************************************************************************
 *
 *  Function:	NormalizeWord
 *
 *  Purpose:	normalize a word number that's in most significant byte format
 *
 *  Returns:	short
 *
 *  Side Effects:	none
 *
 *  Description:
 *				takes a long in msb format order and converts it
 *				to lsb format order.  For example, the long value
 *				0x12345678 becomes 0x78563412
 *				0x78563412 becomes 0x12345678
 *
 ************************************************************************/
short
NormalizeWord(incoming)
short	incoming;
{
	unsigned char	*byteArray;
	short	result;
	
	byteArray = (unsigned char *) &incoming;
	result = (short) byteArray[0] | 
			 (short) byteArray[1] << 8;
	
	return result;
}
