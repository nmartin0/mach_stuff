		$"3000 0000 4800 00C0 0800 0120 107F 0020"
		$"01D5 E040 16AA B040 0D55 5800 1AAA AC40"
		$"3555 5600 2AAA AB00 557F 5500 6AC1 AB80"
		$"D59C D5C0 AB3E 6AC0 D571 55C0 AB61 6AC0"
		$"D561 55C0 AB22 6AC0 D59C D5C0 6AC1 ABC0"
		$"557F 5580 2AAA AB80 3555 5700 1AAA AF30"
		$"0D55 5E48 66AA BC08 93D5 F810 10FF E010"
		$"203F 8000 2000 0010 0000 0000 20",
		/* [2] */
		$"3000 0000 4800 00C0 0800 0120 107F 0020"
		$"01FF E040 17FF F040 0FFF F800 1FFF FC40"
		$"3FFF FE00 3FFF FF00 7FFF FF00 7FFF FF80"
		$"FFFF FFC0 FFFF FFC0 FFFF FFC0 FFFF FFC0"
		$"FFFF FFC0 FFFF FFC0 FFFF FFC0 7FFF FFC0"
		$"7FFF FF80 3FFF FF80 3FFF FF00 1FFF FF30"
		$"0FFF FE48 67FF FC08 93FF F810 10FF E010"
		$"203F 8000 2000 0010 0000 0000 20"
	}
};

