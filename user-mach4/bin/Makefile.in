SHELL = /bin/sh

SRCDIR     = @srcdir@
TOP_SRCDIR = @top_srcdir@
TOP_OBJDIR = @top_objdir@

prefix      = @prefix@
exec_prefix = @exec_prefix@

CC      = @CC@
DEFINES = @DEFS@
INSTALL = @INSTALL@

LIBDIR = $(exec_prefix)/lib

SUBDIRS = Flags hash_info hostinfo ipc_test mach3 macherr machid machipc \
	massign mcreate mkill mnice mpolicy ms mt netmemoryserver pinfo \
	snames stacks swapon thstate vminfo vmread vmsearch vmstat \
	waitfor xptest zprint

# These require the lites includes.
SUBDIRS += envmgr ps top w 

include $(TOP_SRCDIR)/Makerules.sub

