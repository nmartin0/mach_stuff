/*
 *  File: env_mgr.defs
 *      Definition file for the Mach Environment Manager
 *
 *  Author: Jukka Partanen, Helsinki University of Technology 1992
 *      based on the Mach 2.5 version by Mary Thompson
 *
 */

subsystem env_mgr   1600;

serverprefix do_;

#include <mach/std_types.defs>

type env_name_t 	= (MACH_MSG_TYPE_STRING,80*8);
type env_str_val_t 	= (MACH_MSG_TYPE_STRING,2048*8);
type env_name_list 	= ^array [ ] of env_name_t;
type env_str_list	= ^array [ ] of env_str_val_t;

import <servers/emdefs.h>;

routine env_set_string(	port		: mach_port_t;
   			env_name	: env_name_t;
    		        env_val		: env_str_val_t);


routine env_get_string(	port		: mach_port_t;
   			env_name	: env_name_t;
    		    out env_val		: env_str_val_t);


routine env_del_string(	port		: mach_port_t;
   			env_name	: env_name_t);

routine env_set_port(	port		: mach_port_t;
   			env_name	: env_name_t;
    		        env_val		: mach_port_t);


routine env_get_port(	port		: mach_port_t;
   			env_name	: env_name_t;
    		    out env_val		: mach_port_t);


routine env_del_port(	port		: mach_port_t;
   			env_name	: env_name_t);


routine env_list_strings(port		: mach_port_t;
		    out env_names	: env_name_list,dealloc;
    		    out env_string_vals	: env_str_list ,dealloc);


routine env_list_ports(	port		: mach_port_t;
		    out env_names	: env_name_list,dealloc;
    		    out env_port_vals	: mach_port_array_t);


routine env_set_stlist(	port		: mach_port_t;
		        env_names	: env_name_list;
    		        env_string_vals	: env_str_list);


routine env_set_ptlist(	port		: mach_port_t;
		        env_names	: env_name_list;
    		        env_port_vals	: mach_port_array_t);


routine env_copy_conn(	port		: mach_port_t;
    		     out new_env_port	: mach_port_move_send_t);


routine env_new_conn(	port		: mach_port_t;
    		     out new_env_port	: mach_port_move_send_t);


routine env_restrict_conn(port		: mach_port_t;
    		     out new_env_port	: mach_port_make_send_t);


routine env_disconnect(	port		: mach_port_t);
