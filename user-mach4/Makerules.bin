ifndef _user_makerules_bin_
_user_makerules_bin_ = yes

all: $(TARGET)

SECTIONS += $(SRCPATH)

CLEAN_FILES += $(TARGET)

include $(TOP_SRCDIR)/Makerules
include $(TOP_SRCDIR)/Makerules.man

ifeq ($(TARGET_ARCH), parisc)
# XXX standard crt0.o is _not_ what we want
$(TARGET): $(OBJFILES) $(patsubst %,$(TOP_OBJDIR)/lib/lib%.a,$(TARGET_LIBS))
	$(TARGET_CC) -nostartfiles $(LDFLAGS) $(TARGET_LDFLAGS) -o $@ \
		/usr/mach4/lib/crt0.o $(OBJFILES) $(LIBS)
else
$(TARGET): $(OBJFILES) $(patsubst %,$(TOP_OBJDIR)/lib/lib%.a,$(TARGET_LIBS))
	$(TARGET_CC) $(LDFLAGS) $(TARGET_LDFLAGS) -o $@ \
		$(OBJFILES) $(LIBS)
endif


$(TOP_OBJDIR)/bin/$(TARGET): $(TARGET) $(TOP_OBJDIR)/bin
	cp $< $@

$(TOP_OBJDIR)/bin:
	$(mktargetdir)

install: all $(INSTALL_BINDIR)/$(TARGET) installman
	

endif
