# All the programs and other cruddy little definitions
# are made in just one place, here.
# The directory names still need to be defined
# in their own Makefiles, since they have to vary
# depending on what directory level they're at.  <sigh>

TARGET_OS	=
TARGET_ARCH	= @target_arch@

export CC	= @CC@
export LD	= @LD@
export STRIP	= @STRIP@
export AR	= @AR@
export RANLIB	= @RANLIB@
export MIG	= @MIG@
export MIGDIR	= $(subst bin/$(notdir $(MIG)),lib,$(MIG))

HOST_CC		= @HOST_CC@

INSTALL		= @INSTALL@

DEFINES		= @DEFS@

# XXX this stuff shouldn't be in here!
INCDIRS += @top_objdir@/include /usr/mach4/include
LIBDIRS += /usr/mach4/lib

SRCPATH	   = $(subst $(TOP_SRCDIR)/,,$(SRCDIR))

INSTALL_INCDIR	= $(prefix)/include
INSTALL_BINDIR	= $(exec_prefix)/bin
INSTALL_LIBDIR	= $(exec_prefix)/lib

