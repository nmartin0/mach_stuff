ifndef _user_makerules_lib_
_user_makerules_lib_ = yes

all: includes $(TOP_OBJDIR)/lib/$(TARGET) 

SECTIONS += $(SRCPATH)

CLEAN_FILES += $(TARGET)


# XXX we don't always want to export _everything_!
# Here we generate a list of the header files we'll be exporting.
# Some of them will go in directories other than mach;
# use pattern substitution to kludge this up.
#EXPORTED_HFILES += $(patsubst %.h,servers/%.h, \
#                      $(notdir $(wildcard $(SRCDIR)/*.h)))


# Evaluate the contents of the variable now.
EXPORTED_HFILES := $(EXPORTED_INCLUDES) $(EXPORTED_DEFS)

# Without this rule, make tends to delete intermediate .h files at the wrong time.
.PRECIOUS: $(notdir $(EXPORTED_HFILES))

# We'll need to install the header files produced from the .pres files
# into a subdirectory in our object directory,
# so that the various other user-level packages
# (libmach, libthreads, and bootstrap)
# will be able to find them before they're installed.
# Here's how to do that.
$(TOP_OBJDIR)/include/servers/%.h: %.h
	$(mktargetdir); rm -f $@; cp -p $< $@
$(TOP_OBJDIR)/include/servers/%.defs: %.defs
	$(mktargetdir); rm -f $@; cp -p $< $@


include $(TOP_SRCDIR)/Makerules
include $(TOP_SRCDIR)/Makerules.man

$(TARGET): $(OBJFILES)
	$(AR) $(ARFLAGS) $@ $?
	$(RANLIB) $@

$(TOP_OBJDIR)/lib/$(TARGET): $(TARGET) $(TOP_OBJDIR)/lib
	cp $< $@

$(TOP_OBJDIR)/lib:
	$(mktargetdir)

# XXX the servers/ path should _not_ be hard-coded!
includes: $(addprefix $(TOP_OBJDIR)/include/servers/,$(EXPORTED_HFILES))

install: all $(addprefix $(INSTALL_INCDIR)/servers/,$(EXPORTED_HFILES)) \
        $(INSTALL_LIBDIR)/$(TARGET) installman

endif


