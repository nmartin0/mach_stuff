# This makefile is for the PA-RISC microkernel.
# It is usually included by the Makefile
# configured from the Makefile.in file in this same directory,
# but might be included instead from some other place
# if the PA-RISC code is used in an even more specific configuration.

SHELL = /bin/sh

SRCDIR      = @srcdir@
TOP_SRCDIR  = @top_srcdir@
TOP_OBJDIR  = @top_objdir@

prefix      = @prefix@
exec_prefix = @exec_prefix@

CC      = @CC@
DEFINES = @DEFS@
INSTALL = @INSTALL@

LIBDIR = $(exec_prefix)/lib

SUBDIRS = mach_init

include $(TOP_SRCDIR)/Makerules.sub

