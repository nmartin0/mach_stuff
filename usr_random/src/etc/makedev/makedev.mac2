#! /bin/sh

# /dev/MAKEDEV for mac2.

# Optional argument is alternate /dev directory.

if [ $1 ]; then
  DEV=$1
else
  DEV=/dev
fi

rm -f $DEV/console
mknod $DEV/console c 0 0
chown root.bin $DEV/console
chmod 666 $DEV/console
ls -l $DEV/console

rm -f $DEV/tty
mknod $DEV/tty c 2 0
chown root.bin $DEV/tty
chmod 666 $DEV/tty
ls -l $DEV/tty

